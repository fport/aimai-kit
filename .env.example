# Copy with: cp .env.example .env  (.env is gitignored)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI: the model parameter takes the DEPLOYMENT name, not the model.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# The pricing catalog is not hardcoded; it is read from here.
AIMAI_PRICING_FILE=config/pricing.toml
